# Copy this file to .env and fill in the token. .env is gitignored.
#
# GoodLinks exposes a local HTTP API when "API access" is enabled in
# GoodLinks → Settings → API. Both the address and the token are shown on
# that settings page; paste them as-is (the /api/v1 path is added by the code).
GOODLINKS_API_ADDRESS=http://localhost:9428
GOODLINKS_API_TOKEN=

# Where the local SQLite cache lives (gitignored). Relative paths are
# resolved against the repository root.
GLC_DB_PATH=data/goodlinks.sqlite
